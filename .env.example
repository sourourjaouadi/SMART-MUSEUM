# Variables de la chaine IoT locale (docker-compose.yml). Copier vers .env (ignore par Git) :
#   cp .env.example .env
# Jamais de secret reel dans ce fichier exemple.

# Meme valeur que INGEST_SERVICE_TOKEN du middleware (secret cote serveur, jamais dans une PWA).
INGEST_SERVICE_TOKEN=replace-with-the-middleware-service-token

# URL de base du middleware vue depuis le conteneur Node-RED, sans /api a la fin.
# - API locale HTTPS (scripts de deployment/) : https://api.smartmuseum.test
# - WildFly en HTTP simple sur la meme machine que Docker : http://host.docker.internal:8080
BACKEND_URL=https://api.smartmuseum.test

# Certificat PUBLIC de l'autorite qui signe le HTTPS local de l'API (jamais rootCA-key.pem).
# deployment/prepare-local-https.ps1 utilise mkcert : sa racine est %LOCALAPPDATA%\mkcert\rootCA.pem,
# soit depuis WSL : /mnt/c/Users/<votre-nom>/AppData/Local/mkcert/rootCA.pem
API_CA_CERT=./deployment/smartmuseum-dev.crt

# Nombre maximum d'essais pour une mesure ou une annonce (erreur reseau ou 5xx).
INGEST_MAX_ATTEMPTS=30
