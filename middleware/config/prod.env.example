# Template only. Set secrets via the production secret manager/process environment.
SMART_MUSEUM_ENV=prod
JNOSQL_MONGODB_HOST=
JNOSQL_DOCUMENT_DATABASE=
CORE_SERVICE_URL=https://core.internal.example.invalid/core
IAM_SERVICE_URL=https://iam.internal.example.invalid/iam
INTER_SERVICE_TOKEN=
INGEST_SERVICE_TOKEN=
JWT_SIGNING_KEY_BASE64=
JWT_ISSUER=smart-museum
JWT_ACCESS_TOKEN_SECONDS=900
CORS_ALLOWED_ORIGINS=https://client.example.invalid,https://admin.example.invalid
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SEED_DEVICES=false
MQTT_BROKER_URI=mqtts://broker.example.invalid:8883
TLS_KEYSTORE_PATH=
TLS_KEYSTORE_PASSWORD=
# MongoDB production authentication (populate via secret manager/process environment)
JNOSQL_MONGODB_USER=
JNOSQL_MONGODB_PASSWORD=
JNOSQL_MONGODB_AUTHENTICATION_MECHANISM=SCRAM-SHA-256
# Database that holds the user (JNoSQL property jnosql.mongodb.authentication.source).
JNOSQL_MONGODB_AUTHENTICATION_SOURCE=
