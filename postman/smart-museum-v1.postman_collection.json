    {
      "name": "Geolocalisation",
      "description": "Coordonnees WGS84 des zones et localisation des appareils. A executer dans l'ordre contre l'API HTTPS ({{apiUrl}}). Renseigner adminEmail/adminPassword localement (jamais dans Git) ; 'Login ADMIN' enregistre le jeton dans adminToken. Les coordonnees sont des donnees d'exemple (Tunis).",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Login ADMIN -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('statut 200', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/api/auth/login"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Zones -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('statut 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('liste de zones', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/api/zones"
            }
          }
        },
