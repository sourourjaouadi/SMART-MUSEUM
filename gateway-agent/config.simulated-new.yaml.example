# NOUVEL appareil SIMULE pour la demonstration de decouverte (P1.3) :
# au demarrage il annonce sa Thing Description sur museum/v1/salle-02/sim-bme280-03/td,
# Node-RED la relaie vers POST /api/things et le middleware l'enregistre en « pending ».
# Ses mesures sont refusees (403) jusqu'a l'approbation par un ADMIN, puis acceptees.
gateway:
  id: gw-sim
  zone_id: salle-02
  device_id: sim-bme280-03

sensor:
  type: simulated
  interval_seconds: 10

mqtt:
  host: localhost
  port: 1883
  keepalive: 30
  qos: 1
  topic_prefix: museum/v1
  announce_td: true
  tls:
    enabled: false
    ca_certs: null

logging:
  level: INFO
