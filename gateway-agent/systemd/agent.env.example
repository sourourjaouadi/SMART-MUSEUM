# Copier vers /etc/smart-museum/agent.env (chmod 600, propriétaire root).
# Ne JAMAIS commiter ce fichier une fois rempli.
PYTHONPATH=/opt/smart-museum/gateway-agent/src
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_HOST=192.168.1.20
