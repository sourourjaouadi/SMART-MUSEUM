# MQTT_PORT=8883
# MQTT_TLS_ENABLED=true
# MQTT_TLS_CA_CERTS=/etc/smart-museum/ca.crt
# MQTT_USERNAME=bme280-01
# MQTT_PASSWORD=
# ANNOUNCE_TD=true
