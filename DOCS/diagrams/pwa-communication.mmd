flowchart LR
    staff["Museum staff"]
    pwa["Client PWA"]
    api["Backend API"]
    db[("MongoDB")]

    staff -->|"1: Select zone / open dashboard"| pwa
    pwa -->|"1.1: GET /api/devices"| api
