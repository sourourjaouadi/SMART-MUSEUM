# Adds only the API Undertow host if it does not already exist.
# It does not change listeners, HTTPS, aliases on existing hosts, or management.
if (outcome == success) of /subsystem=undertow/server=default-server/host=api-smartmuseum-host:read-resource
    echo API host already exists; current aliases follow. No changes made.
    /subsystem=undertow/server=default-server/host=api-smartmuseum-host:read-attribute(name=alias)
else
    /subsystem=undertow/server=default-server/host=api-smartmuseum-host:add(alias=["api.smartmuseum.test", "api.example.invalid"])
end-if
