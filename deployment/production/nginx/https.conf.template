limit_req_zone $binary_remote_addr zone=museum_login:10m rate=30r/m;

server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 443 ssl http2 default_server;
    server_name _;
    ssl_reject_handshake on;
}
server {
    listen 80;
    server_name @CLIENT_HOST@ @ADMIN_HOST@ @API_HOST@;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name @CLIENT_HOST@;
    ssl_certificate @CERT@;
    ssl_certificate_key @KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' https://@API_HOST@; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    location / {
        proxy_pass http://127.0.0.1:8180;
        include @PROXY@;
    }
}
server {
    listen 443 ssl http2;
    server_name @ADMIN_HOST@;
    ssl_certificate @CERT@;
    ssl_certificate_key @KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' https://@API_HOST@; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    location / {
        proxy_pass http://127.0.0.1:8180;
        include @PROXY@;
    }
}
server {
    listen 443 ssl http2;
    server_name @API_HOST@;
    ssl_certificate @CERT@;
    ssl_certificate_key @KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    location = /api/auth/login {
        limit_req zone=museum_login burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8180;
        include @PROXY@;
    }
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8180;
        include @PROXY@;
    }
    # /core, /iam and everything else are not public.
    location / { return 404; }
}
